# ============================================================
# SAAS_LOGIN - EJEMPLO DE BACKEND
# ============================================================
# Las URLs se generan desde SAAS_CONFIG/saas.env mediante SYNC_CONFIG.bat.
# Las credenciales MASTER se preservan y se configuran localmente.
APP_ENV=local
APP_DEBUG=true
APP_TIMEZONE=America/Argentina/Cordoba
SAAS_ORIGIN=http://localhost
ALLOWED_ORIGINS=http://localhost:3010,http://localhost:3000,http://localhost:3002
ALLOWED_SYSTEM_CODES=SOCIOS,COOPERADORA
SESSION_HOURS=12
LOGIN_FRONTEND_URL=http://localhost:3010
LOGIN_API_URL=http://localhost:3011/routes/api.php
SOCIOS_FRONTEND_URL=http://localhost:3000
SOCIOS_API_URL=http://localhost:3001/routes/api.php
COOPERADORA_FRONTEND_URL=http://localhost:3002
COOPERADORA_API_URL=http://localhost:3003/routes/api.php

MASTER_DB_HOST=localhost
MASTER_DB_PORT=3306
MASTER_DB_NAME=socios_master
MASTER_DB_USER=root
MASTER_DB_PASS=
